---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const isPrivacy = Astro.url.pathname.startsWith('/privacy-policy');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#253e32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-paper focus:p-3">Skip to content</a>
    <header class="border-b border-line">
      <nav aria-label="Main navigation" class="mx-auto flex max-w-4xl items-center justify-between gap-6 px-6 py-6">
        <a href="/" class="flex items-center gap-3 text-xl font-semibold no-underline"><img src="/favicon.svg" alt="" width="32" height="32" />BirdNote</a>
        <a href="/privacy-policy" aria-current={isPrivacy ? 'page' : undefined} class="text-sm text-muted hover:text-ink hover:underline">Privacy policy</a>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-16 sm:py-24"><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-sm text-muted">
        <span>BirdNote · Learn at your own pace.</span>
        <a href="mailto:enzotomassi@gmail.com" class="hover:text-ink hover:underline">Contact</a>
      </div>
    </footer>
  </body>
</html>
