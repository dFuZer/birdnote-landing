---
import Layout from '../layouts/Layout.astro';
---
<Layout title="BirdNote — Learn to read music" description="Practice reading notes, intervals, and chords with BirdNote, a free offline Android app. No account. No ads.">
  <section class="max-w-2xl">
    <p class="mb-6 text-sm font-medium tracking-widest uppercase text-muted">Music practice, made simple</p>
    <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">A little practice.<br />A better feel for music.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">Learn to read notes, intervals, and chords on a music staff. BirdNote gives you short practice rounds and immediate piano feedback, wherever you are.</p>
    <p class="mt-5 text-sm text-muted">Free for Android. Fully offline. No account. No ads.</p>
    <a href="/privacy-policy" class="mt-9 inline-block rounded-lg bg-ink px-5 py-3 text-sm font-medium text-white no-underline hover:bg-ink/90">Read our privacy policy <span aria-hidden="true">↗</span></a>
  </section>
  <section aria-label="About BirdNote" class="mt-16 grid gap-8 border-t border-line pt-8 sm:grid-cols-3">
    <div><h2 class="font-semibold">Read. Answer. Hear.</h2><p class="mt-2 text-sm leading-relaxed text-muted">Recognize the notation and hear the notes as you practice.</p></div>
    <div><h2 class="font-semibold">Find your pace.</h2><p class="mt-2 text-sm leading-relaxed text-muted">Choose your clef and difficulty, then work toward your personal best.</p></div>
    <div><h2 class="font-semibold">Keep it private.</h2><p class="mt-2 text-sm leading-relaxed text-muted">Your settings and scores stay in the app’s local storage. No tracking.</p></div>
  </section>
</Layout>
